<mvc:View	controllerName="Homepage.Homepage.controller.HomeView"
			xmlns:mvc="sap.ui.core.mvc"
			xmlns="sap.m"
			xmlns:core="sap.ui.core"
			xmlns:tnt="sap.tnt"
			xmlns:html="http://www.w3.org/1999/xhtml">

	<Page	id="idPageHome"
			title="HomeView"
			showHeader="false">
		
		<subHeader>
			<core:Fragment fragmentName="Homepage.Homepage.view.fragments.Header" type="XML"/>
		</subHeader>
		
		<content>
			<html:div class="pageContentBlock">
				<core:Fragment fragmentName="Homepage.Homepage.view.fragments.Home" type="XML"/>
			</html:div>
			<VBox class="scrollFlexSpacer"/>
			<HBox id="idHomeScrollEndMarker" class="scrollEndMarker" height="1px"/>
			<core:Fragment fragmentName="Homepage.Homepage.view.fragments.Footer" type="XML"/>
		</content>

	</Page>

</mvc:View>
