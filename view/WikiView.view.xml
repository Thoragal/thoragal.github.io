<mvc:View	controllerName="Homepage.Homepage.controller.WikiView"
			xmlns:core="sap.ui.core" 
			xmlns:mvc="sap.ui.core.mvc" 
			xmlns="sap.m" 
			xmlns:html="http://www.w3.org/1999/xhtml">

	<Page	id="idPageWiki"
			title="Title"
			showHeader="false">
		
		<subHeader>
			<core:Fragment fragmentName="Homepage.Homepage.view.fragments.Header" type="XML"/>
		</subHeader>
		
		<content>
			<html:div class="pageContentBlock">
				<core:Fragment fragmentName="Homepage.Homepage.view.fragments.Wiki" type="XML"/>
			</html:div>
			<VBox class="scrollFlexSpacer"/>
			<HBox id="idWikiScrollEndMarker" class="scrollEndMarker" height="1px"/>
			<core:Fragment fragmentName="Homepage.Homepage.view.fragments.Footer" type="XML"/>
		</content>

	</Page>

</mvc:View>