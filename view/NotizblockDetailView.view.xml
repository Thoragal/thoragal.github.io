<mvc:View	controllerName="Homepage.Homepage.controller.NotizblockDetailView"
			xmlns:core="sap.ui.core"
			xmlns:mvc="sap.ui.core.mvc"
			xmlns="sap.m"
			xmlns:html="http://www.w3.org/1999/xhtml">

	<Shell>
		<App>
			<pages>
				<Page	id="idPageNotizblockDetail"
						title="Title"
						showHeader="false">

					<subHeader>
						<core:Fragment fragmentName="Homepage.Homepage.view.fragments.Header" type="XML"/>
					</subHeader>

					<content>
						<html:div class="pageContentBlock">
							<core:Fragment fragmentName="Homepage.Homepage.view.fragments.NotizblockDetail" type="XML"/>
						</html:div>
						<VBox class="scrollFlexSpacer"/>
						<HBox id="idNotizblockDetailScrollEndMarker" class="scrollEndMarker" height="1px"/>
						<core:Fragment fragmentName="Homepage.Homepage.view.fragments.Footer" type="XML"/>
					</content>

					<footer>
						<core:Fragment fragmentName="Homepage.Homepage.view.fragments.NotizblockDetailFooter" type="XML"/>
					</footer>

				</Page>
			</pages>
		</App>
	</Shell>
</mvc:View>
