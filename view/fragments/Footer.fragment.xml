<core:FragmentDefinition	xmlns="sap.m" 
							xmlns:core="sap.ui.core"
							xmlns:tnt="sap.tnt">

	<Toolbar visible="{footerModel>/visible}" class="stickyFooterToolbar">
		<Text text="{i18n>FooterCopyright}" class="footerCopyrightText"/>
		<ToolbarSpacer/>
		<HBox class="footerLinksGroup">
			<Link text="{i18n>FooterPrivacy}" press="onNavToDatenschutz" class="footerImprintText"/>
			<Text text="|" class="footerImprintText footerSeparator"/>
			<Link text="{i18n>FooterImprint}" press="onNavToImpressum" class="footerImprintText"/>
		</HBox>
	</Toolbar>

</core:FragmentDefinition>