<core:FragmentDefinition	xmlns="sap.m"
							xmlns:core="sap.ui.core">

	<OverflowToolbar>
		<ToolbarSpacer/>
		<ToolbarSpacer/>
		<Button id="btnNavUpNotizblock" icon="sap-icon://navigation-up-arrow" text="{i18n>NotizblockDetailNavUp}" press="onNavToNotizblock"/>
		<Button id="btnNavLeftNotizblock" icon="sap-icon://navigation-left-arrow" text="{ path: 'i18n>textBtnNavLeft', formatter:'.formatter.device' }" press="onNavToNotizblockDetailPrevious"/>
		<Button id="btnNavRightNotizblock" icon="sap-icon://navigation-right-arrow" text="{ path: 'i18n>textBtnNavRight', formatter:'.formatter.device'}" press="onNavToNotizblockDetailNext"/>
	</OverflowToolbar>

</core:FragmentDefinition>
